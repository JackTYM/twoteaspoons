# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Neon Auth (Stack Auth based)
NEON_AUTH_URL="https://ep-xxx.neonauth.c-X.REGION.aws.neon.build/DATABASE/auth"
NUXT_PUBLIC_NEON_AUTH_URL="https://ep-xxx.neonauth.c-X.REGION.aws.neon.build/DATABASE/auth"

# Neon Data API (for REST queries)
NEON_DATA_API_URL="https://ep-xxx.neonauth.c-X.REGION.aws.neon.build/DATABASE/data"
NUXT_PUBLIC_NEON_DATA_API_URL="https://ep-xxx.neonauth.c-X.REGION.aws.neon.build/DATABASE/data"

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="twoteaspoons-images"
# Must be a domain that serves objects publicly (custom domain mapped to the bucket).
# The raw *.r2.cloudflarestorage.com endpoint and the pub-*.r2.dev dev URL both require auth/are not for production use.
R2_PUBLIC_URL="https://image.yourdomain.com"
